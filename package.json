{
  "name": "edge-verify",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,wrangler -c cyan,orange \"vite --port 5173\" \"wrangler pages dev --proxy 5173 --port 8788\"",
    "dev:vite": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ship": "pnpm run build && wrangler pages deploy dist"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wrangler": "^3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
